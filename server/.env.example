PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/agent-orchestration
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# AGENT_PROVIDER=mock (default) | openai | opencode | anthropic
# The check scripts always run with mock, whatever is set here.
AGENT_PROVIDER=mock

# --- OpenAI (AGENT_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# low | medium | high - only for reasoning models; leave empty otherwise
OPENAI_REASONING_EFFORT=
OPENAI_MAX_COMPLETION_TOKENS=4096
# leave empty for api.openai.com; set for an OpenAI-compatible gateway
OPENAI_BASE_URL=

# --- Anthropic (AGENT_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

DEFAULT_TOOL_FAILURE_RATE=0.1
# worker pool size shared by every workspace; per-workspace caps come from the plan (spec/33)
QUEUE_CONCURRENCY=8
QUEUE_MAX_ATTEMPTS=3

# base retry backoff for the in-process job queue (doubles per attempt)
QUEUE_BASE_BACKOFF_MS=500

# overall run deadline; a run exceeding it fails with cancelReason=timeout
RUN_TIMEOUT_MS=120000

# base URL used to build copy-pasteable webhook URLs
PUBLIC_BASE_URL=http://localhost:4000

# credential vault key (spec/25): 32 bytes of base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_MASTER_KEY=

# live integrations by default (spec/26, C2); false = sandbox everywhere
INTEGRATIONS_LIVE=true

# SSRF guard for all outbound requests (spec/27). Private networks: local development only.
HTTP_TOOL_ALLOW_PRIVATE_NETWORKS=false
# optional comma-separated allowlist, supports *.example.com
HTTP_TOOL_ALLOWED_HOSTS=

# Advanced nodes (spec 31). Code nodes run with server privileges - trusted code only.
CODE_NODE_ENABLED=true
CODE_NODE_TIMEOUT_MS=1000
CODE_NODE_MEMORY_MB=64
# Delays longer than DELAY_INLINE_MAX_MS need run parking (spec 32); capped at DELAY_MAX_MS.
DELAY_INLINE_MAX_MS=60000
DELAY_MAX_MS=86400000
LOOP_MAX_ITEMS=500
SUBWORKFLOW_MAX_DEPTH=5

# collaboration hub (spec/28): draft flush debounce / hard ceiling, soft-lock TTL
COLLAB_FLUSH_DEBOUNCE_MS=1000
COLLAB_FLUSH_MAX_MS=5000
COLLAB_LOCK_TTL_MS=60000

# MCP servers and agent tool use (spec/37)
# model used when AGENT_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5
# per MCP tools/call timeout (max 30000)
MCP_CALL_TIMEOUT_MS=30000
# tool results are cut to this many characters before going back to the model
AGENT_TOOL_RESULT_MAX_CHARS=8000
# idle MCP clients are closed after this long
MCP_IDLE_CLOSE_MS=300000
# operator allowlist of local (stdio) MCP servers, relative to server/
MCP_ALLOWLIST_PATH=mcp-servers.json

# signs approve/reject links (spec 32); falls back to a key derived from JWT_SECRET
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APPROVAL_LINK_SECRET=

# comma-separated emails that may see the cross-tenant status view (spec/36); empty = nobody
OPERATOR_EMAILS=

# --- OpenCode Zen (AGENT_PROVIDER=opencode) - OpenAI-compatible gateway, free models ---
# Chat Completions models only: mimo-v2.6-flash-free, ling-3.0-flash-fin-free,
# nemotron-3-ultra-free, nemotron-3.5-lightning-free (Muse uses /responses and
# Jev a custom API - not supported). Compare them: npm run try:llm -- --models a,b
OPENCODE_API_KEY=
OPENCODE_MODEL=mimo-v2.6-flash-free
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MAX_TOKENS=4096
