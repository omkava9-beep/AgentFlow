PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/agent-orchestration
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# AGENT_PROVIDER=mock (default) | anthropic
AGENT_PROVIDER=mock
ANTHROPIC_API_KEY=

DEFAULT_TOOL_FAILURE_RATE=0.1
QUEUE_CONCURRENCY=4
QUEUE_MAX_ATTEMPTS=3

# base retry backoff for the in-process job queue (doubles per attempt)
QUEUE_BASE_BACKOFF_MS=500

# overall run deadline; a run exceeding it fails with cancelReason=timeout
RUN_TIMEOUT_MS=120000
